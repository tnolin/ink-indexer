# Postgres connection string. `pnpm db:dev` prints a local one.
DATABASE_URL=
# Comma-separated RPC URLs (wss://, ws://, https:// or http://). Reads use the HTTP form and follow recent success and latency; ws(s) entries give new-head notifications. Empty uses the built-in Ink defaults.
INK_RPC_WS_URLS=
# debug | info | warn | error (default info)
LOG_LEVEL=
# Sentry DSN for fatal and stall exits. Empty disables Sentry.
SENTRY_DSN=
# Release name reported to Sentry, normally the deployed git tag.
SENTRY_RELEASE=
# Comma-separated platforms to run: inkypump, opensea, chimera. Empty runs all three.
INDEXER_SOURCES=
# OpenSea API key for collection pages, drops, stats and listings. Empty runs the chain sources only.
OPENSEA_API_KEY=
# OpenSea requests per hour, shared by every process using the key (default 500).
OPENSEA_REQUESTS_PER_HOUR=
# Minimum milliseconds between two OpenSea requests on the key, across every process (default 300).
OPENSEA_MIN_INTERVAL_MS=
# Minimum milliseconds between the starts of two live ticks, 0 to 60000 (default 0, a tick on every new block). A higher value reads several blocks per request, with up to that much extra latency for every source.
TICK_MIN_INTERVAL_MS=
# The block the NFT mint backfill started from; collections that minted earlier are legacy. Empty uses the first stored mint.
NFT_HISTORY_START_BLOCK=
# HTTPS origin of the IPFS gateway for ink.fun token metadata and images. Empty uses https://cracker.mypinata.cloud.
IPFS_GATEWAY=
