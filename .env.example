# Postgres connection string. `pnpm db:dev` prints a local one.
DATABASE_URL=
# Comma-separated RPC URLs (wss://, ws://, https:// or http://). Reads use the HTTP form and follow recent success and latency; ws(s) entries give new-head notifications. Empty uses the built-in Ink defaults.
INK_RPC_WS_URLS=
# debug | info | warn | error (default info)
LOG_LEVEL=
# Sentry DSN for fatal and stall exits. Empty disables Sentry.
SENTRY_DSN=
# Release name reported to Sentry, normally the deployed git tag.
SENTRY_RELEASE=
